{
    "name": "chatify",
    "version": "1.0.50",
    "module": "src/index.ts",
    "scripts": {
        "dev": "bun run --watch src/index.ts",
        "tailwind": "bunx @tailwindcss/cli -i ./public/input.css -o ./public/style.css --watch",
        "build": "bunx @tailwindcss/cli -i ./public/input.css -o ./public/style.css --minify",
        "db:generate": "bunx drizzle-kit generate",
        "db:migrate": "bunx drizzle-kit migrate",
        "db:push": "bunx drizzle-kit push",
        "db:studio": "bunx drizzle-kit studio"
    },
    "dependencies": {
        "@elysia/static": "^1.4.11",
        "@elysiajs/html": "^1.4.2",
        "@kitajs/html": "^4.2.13",
        "@tailwindcss/cli": "^4.3.3",
        "alpinejs": "^3.17.5",
        "drizzle-orm": "^0.45.2",
        "elysia": "^1.4.29",
        "htmx.org": "4.0.2",
        "postgres": "^4.1.1",
        "tailwindcss": "^4.3.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "bun-types": "^1.3.14",
        "daisyui": "^5.7.9",
        "drizzle-kit": "^0.31.10"
    },
    "overrides": {
        "ws": "^8.20.1",
        "esbuild": "^0.25.0"
    }
}