NODE_ENV=development
PORT=3000
DB_URL=postgres://chatify:chatify_dev_password@localhost:5433/chatify
TEST_DB_URL=postgres://chatify:chatify_dev_password@localhost:5433/chatify_test
COOKIE_SECRET=dev-only-cookie-secret-key-minimum-32-chars

# S3-Compatible Object Storage (opsional di dev; jika kosong akan memakai penyimpanan lokal)
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=chatify-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
